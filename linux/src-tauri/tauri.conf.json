{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SyncLocal360 Galeria",
  "mainBinaryName": "synclocal360-galeria",
  "version": "1.0.0",
  "identifier": "org.synclocal360.galeria",
  "build": {
    "frontendDist": "../../resources/gallery"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "SyncLocal360 Galeria",
        "width": 1400,
        "height": 900,
        "minWidth": 760,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage"
    ],
    "category": "GraphicsAndDesign",
    "shortDescription": "Galeria lokalnych kopii projektów Fusion",
    "longDescription": "Przeglądanie i porządkowanie lokalnych kopii projektów z dodatku SyncLocal360: kategorie, etykiety, notatki, otwieranie plików STEP w wybranych programach.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "copyright": "Cyryl Sochacki; na bazie NoCloud2 – Kamil Sokalski (modelowanie3d.org)",
    "publisher": "Cyryl Sochacki"
  }
}
